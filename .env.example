# Copie para .env e preencha. NUNCA versione o .env.
# Nenhuma chave é necessária para rodar os testes (pytest) nem o lint.

# --- LLM (roteiros, ideias, análise) ---
ANTHROPIC_API_KEY=
# Opcional: roteador OpenAI/Anthropic-compatível (OmniRoute) para fallback entre modelos.
# LLM_BASE_URL=http://localhost:20128/v1
# LLM_API_KEY=

# --- Geração/transformação de vídeo (PAGO por uso) ---
FAL_KEY=
REPLICATE_API_TOKEN=

# --- Voz (opcional) ---
ELEVENLABS_API_KEY=

# --- Controle de custo ---
VVF_MAX_SPEND_USD=5.00          # teto por execução; 0 bloqueia qualquer chamada paga
VVF_ALLOW_PAID_CALLS=false      # precisa ser "true" para qualquer API paga rodar

# --- Pastas e cache ---
VVF_PROJECTS_DIR=projects
VVF_CACHE_DIR=.cache/vvf

# --- Transcrição local ---
VVF_WHISPER_MODEL=small         # tiny|base|small|medium; baixa o modelo no 1º uso
VVF_WHISPER_DEVICE=cpu
VVF_WHISPER_COMPUTE_TYPE=int8

# --- Privacidade das ferramentas auxiliares ---
HEADROOM_BEACON=off
DO_NOT_TRACK=1
CLAUDE_MEM_TELEMETRY=off
